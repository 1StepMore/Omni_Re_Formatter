# ORF Environment Variables
# Copy this file to `.env` and edit values for your local install.
# `orf` does NOT auto-load this file unless ORF_AUTOLOAD_DOTENV=1 is set
# (no python-dotenv dependency from pip; uses stdlib only).
# Otherwise, export the variables in your shell or via your process
# manager (systemd, docker, etc.).

# --- MCP server (used by src/orf/mcp/config.py) ---
# Comma-separated list of directories the MCP server is allowed to read from.
ORF_MCP_ALLOWED_DIRS=/path/to/allowed
# Maximum file size (MiB) the MCP server will process. Default: 100.
ORF_MCP_MAX_FILE_SIZE=100
# Per-request timeout (seconds) for MCP tool calls. Default: 30.
ORF_MCP_TIMEOUT=30

# --- CLI / cache (used by src/orf/cli.py) ---
# Cache directory used by the CLI for transient artifacts (content-addressed).
OMNI_CACHE_DIR=$HOME/.omni_cache
# Test-only override: when set to "1", skip invoking real pandoc.
OMNI_TEST_FAKE_PANDOC=0
# Opt-in .env auto-loading. When set to "1", orf reads .env from CWD
# using stdlib dotenv support (no python-dotenv dependency).
ORF_AUTOLOAD_DOTENV=1

# --- Logging ---
# Standard logging level name: DEBUG | INFO | WARNING | ERROR
ORF_LOG_LEVEL=INFO

# === S3 / Azure (standard SDK env vars) ===
# If you want ORF to write to S3 or Azure Blob Storage, set these in your
# shell or process manager. ORF passes credentials to boto3 / Azure SDK,
# which read their own standard env var names (not ORF_-prefixed).
#
#   # AWS S3 (boto3 reads these directly):
#   AWS_ACCESS_KEY_ID=AKIA...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_DEFAULT_REGION=us-east-1
#
#   # Azure Blob Storage (Azure SDK reads these directly):
#   AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=...
#
# ORF does NOT inspect, prefix, or rename these vars — they flow through
# to the respective SDKs unchanged.
